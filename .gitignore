# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Virtual environments
venv/
env/
.venv/

# Environment and sensitive credential files
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.cert
*.pfx

# SQLite & database files (machine-specific runtime data)
*.db
*.sqlite
*.sqlite3
data/
data/*.db

# PyInstaller build artifacts
build/
dist/
*.toc
*.pkg
*.pyz
base_library.zip
localpycs/
warn-*.txt
xref-*.html

# Logs & Screenshots
logs/
logs/*.log
logs/*.log.*
logs/screenshots/*

# App index (machine-specific paths generated at runtime)
backend/data/app_index.json

# IDE / editor
.idea/
.vscode/
*.code-workspace

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Python eggs & test cache
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.tmp
*.bak
*.swp
scratch/
