# DRAX AI Environment Variables Configuration

# Cloud Environment ("production" or "development")
DRAX_ENV=production

# Public Cloud API Server Port
PORT=8765

# Allowed CORS Origins (comma-separated list for production, or "*" for development)
CORS_ORIGINS=https://drax-ai.vercel.app,http://localhost:3000,http://127.0.0.1:8765

# Cloud Endpoint URL for Windows Agent connection
DRAX_CLOUD_URL=https://drax-cloud-api.onrender.com

# Web Frontend Cloud API URL (Fallback endpoint)
DRAX_API_URL=https://drax-cloud-api.onrender.com
